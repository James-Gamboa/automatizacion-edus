# Copy to .env and fill in values. Never commit .env.

# Required credentials (never hardcode in source)
EDUS_CEDULA=
EDUS_CLAVE=

# Optional identification type: 0=nacional, 6=temporal, 7=extranjero
EDUS_TIP_IDENTIFICACION=0

# Optional family member booking (login as titular)
FAMILIAR_CEDULA=
FAMILIAR_NOMBRE=

# Optional: exclude dates DD/MM/AAAA,DD/MM/AAAA
EXCLUIR_FECHAS=

# Optional: verify assigned health center text appears after login
CENTRO_SALUD=

# Specialty code overrides (defaults follow official guide for medicina)
SERVICIO=1
ESPECIALIDAD=1033
# ODONTO_SERVICIO=
# ODONTO_ESPECIALIDAD=

# Browser — if you see "Request Rejected", set EDUS_HEADLESS=false and wait 15–30 min
EDUS_HEADLESS=true
EDUS_SLOW_MO_MS=0
EDUS_NAVIGATION_TIMEOUT_MS=90000
EDUS_ACTION_TIMEOUT_MS=30000
EDUS_AJAX_WAIT_SECONDS=4
# EDUS_BROWSER_CHANNEL=chrome

# CAPTCHA — keep moderate to avoid WAF bans from rapid retries
EDUS_CAPTCHA_MAX_ATTEMPTS=15
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Windows / monitor window (Costa Rica) — when slots typically release
EDUS_MONITOR_START_HOUR=5
EDUS_MONITOR_END_HOUR=8
EDUS_ENFORCE_MONITOR_WINDOW=true

# Only auto-book appointment times inside this clock window
EDUS_SLOT_START=05:00
EDUS_SLOT_END=08:00
EDUS_ENFORCE_SLOT_WINDOW=true

# Safety
EDUS_DRY_RUN=false
EDUS_LOG_LEVEL=INFO
